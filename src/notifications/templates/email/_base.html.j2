{# Shared HTML wrapper used by every alert email. #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
           color: #1a1a1a; line-height: 1.5; margin: 0; padding: 24px; background: #f5f5f7; }
    .card { background: #ffffff; border-radius: 8px; padding: 24px; max-width: 640px;
            margin: 0 auto; border: 1px solid #e1e4e8; }
    .severity { display: inline-block; padding: 4px 10px; border-radius: 4px;
                font-weight: 600; font-size: 12px; letter-spacing: 0.05em;
                text-transform: uppercase; }
    .severity-critical { background: #fde7e9; color: #b30021; }
    .severity-warning  { background: #fff4ce; color: #735c00; }
    .severity-info     { background: #e1f5fe; color: #0277bd; }
    h1 { font-size: 20px; margin: 12px 0 16px 0; }
    .meta { color: #586069; font-size: 13px; margin-bottom: 16px; }
    .detail { background: #f6f8fa; border-left: 3px solid #d1d5da;
              padding: 12px 16px; margin: 16px 0; font-family: "SFMono-Regular",
              Consolas, Menlo, monospace; font-size: 13px; }
    .detail dt { font-weight: 600; color: #24292e; }
    .detail dd { margin: 0 0 8px 0; }
    .footer { color: #8b949e; font-size: 12px; margin-top: 24px;
              padding-top: 16px; border-top: 1px solid #e1e4e8; }
  </style>
</head>
<body>
  <div class="card">
    <span class="severity severity-{{ severity }}">{{ severity_display }}</span>
    <h1>{{ title }}</h1>
    <div class="meta">{{ occurrence_count_text }}</div>
    {% block body %}{% endblock %}
    <div class="footer">
      Favonius Energy alerts &middot; alert id {{ alert_id }}<br>
      Manage notification preferences in your Favonius dashboard.
    </div>
  </div>
</body>
</html>
