# Favonius Energy EV Fleet Depot Optimization Platform
# Copy this file to .env and fill in your actual values
#
# Reference: PRD_v2.md, Development Plan Phase 7

# =============================================================================
# DOCKER COMPOSE CONFIGURATION (Phase 7)
# =============================================================================

# Database password for TimescaleDB container
DB_PASSWORD=favonius_dev

# Gurobi license (required for primary solver per PRD Section 8.2)
# Place your gurobi.lic file in the project root
GUROBI_LICENSE_FILE=/opt/gurobi/gurobi.lic

# OCPP Simulator settings (for testing profile)
NUM_CHARGERS=10
CHARGER_PREFIX=charger_
SIMULATION_MODE=responsive

# EVerest demo image tag for docker-compose.everest.yml
EVEREST_TAG=2025.10.0-single-phase
EVEREST_CHARGE_POINT_ID=charger_01
# EVEREST_CSMS_URI=api:9000/charger_01

# Grafana credentials (for monitoring profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# CORS configuration
CORS_ORIGINS=*

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development/staging/production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=false

# Supabase JWT → static DB tenant mirror (see CLAUDE.md "Tenant mirroring")
# Cache TTL in seconds per user (sub); reduces UPSERT frequency on hot paths
# TENANT_MIRROR_TTL_S=300

# =============================================================================
# WEBSOCKET SERVER CONFIGURATION
# =============================================================================

# WebSocket server settings
# OCPP_USE_SAME_PORT: true = serve OCPP at /ocpp/{charge_point_id} on same port as REST (e.g. Railway)
OCPP_USE_SAME_PORT=false
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=9000
MAX_CONNECTIONS=100
HEARTBEAT_INTERVAL=30
MESSAGE_TIMEOUT=60
MAX_MESSAGE_SIZE=65536
RATE_LIMIT_PER_MINUTE=100

# Forwarded IP handling for charger connections behind Railway/Nginx/load balancers.
# Forwarded headers are trusted only from private/loopback peers by default, or from
# proxies listed in OCPP_TRUSTED_PROXY_RANGES. Direct public charger clients cannot
# spoof these headers.
OCPP_TRUST_PRIVATE_PROXY_HEADERS=true
# OCPP_TRUSTED_PROXY_RANGES=203.0.113.10/32,2001:db8::/32

# =============================================================================
# TLS/SSL CONFIGURATION (Optional)
# =============================================================================

# TLS certificate paths (optional for local development)
# TLS_CERT_PATH=/path/to/server.crt
# TLS_KEY_PATH=/path/to/server.key
# TLS_CA_PATH=/path/to/ca.crt
# TLS_VERIFY_CLIENT=false

# =============================================================================
# TIMESCALEDB CONFIGURATION
# =============================================================================

# TimescaleDB connection settings
TIMESCALE_SERVICE_URL=postgresql://username:password@host:port/database?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=ev_charging
PGUSER=postgres
PGPASSWORD=password
PGSSLMODE=require

# Connection pool settings
TIMESCALE_MAX_CONNECTIONS=100
TIMESCALE_POOL_SIZE=20
TIMESCALE_STATEMENT_TIMEOUT=30
TIMESCALE_IDLE_TIMEOUT=600

# Data retention and compression
TIMESCALE_CHUNK_INTERVAL=1 day
TIMESCALE_COMPRESSION_AFTER=7 days
TIMESCALE_RETENTION_PERIOD=2 years

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Supabase database connection (for direct access)
SUPABASE_DB_HOST=aws-1-us-east-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# Connection settings
SUPABASE_MAX_CONNECTIONS=20
SUPABASE_CONNECTION_TIMEOUT=30
SUPABASE_ENABLE_REALTIME=true

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus metrics
METRICS_PORT=8080
HEALTH_CHECK_PORT=8081

# Logging
LOG_LEVEL=INFO
ENABLE_TELEMETRY=true

# Rate limiting configuration
EXPECTED_STATIONS=100
RATE_LIMIT_ENABLED=true

# =============================================================================
# PRICE FEEDER CONFIGURATION
# =============================================================================

# Price feeder settings (CAISO for US, ENTSO-E for Europe)
PRICE_FEEDER_ENABLED=true
PRICE_FEEDER_BASE_URL=https://oasis.caiso.com/oasisapi/SingleZip
PRICE_FEEDER_NODES=TH_SP15_GEN-APND,TH_NP15_GEN-APND
PRICE_FEEDER_FETCH_INTERVAL=900
PRICE_FEEDER_LOOKAHEAD_HOURS=24

# ENTSO-E European electricity prices (optional - for European depots)
# Comma-separated list of EIC bidding zone codes to monitor
# Examples: 10Y1001A1001A82H (DE-LU), 10YFR-RTE------C (FR), 10YNL----------L (NL)
PRICE_FEEDER_ENTSOE_ZONES=
# ENTSO-E Transparency Platform API security token
EUROPEAN_ELECTRICITY_API=

# =============================================================================
# OPTIMIZATION ENGINE CONFIGURATION
# =============================================================================

# Optimization service settings
OPTIMIZATION_ENABLED=true
OPTIMIZATION_HORIZON_HOURS=4
OPTIMIZATION_TIMESTEP_MINUTES=60

# Battery constraints
OPTIMIZATION_SOC_MIN=0.2
OPTIMIZATION_SOC_TARGET=0.8
OPTIMIZATION_CHARGE_POWER_KW=22.0
OPTIMIZATION_DISCHARGE_POWER_KW=10.0
OPTIMIZATION_BATTERY_CAPACITY_KWH=75.0

# =============================================================================
# MINIMUM HARDWARE REQUIREMENTS
# =============================================================================

# For development:
# - CPU: 2 cores minimum, 4 cores recommended
# - RAM: 4GB minimum, 8GB recommended
# - Storage: 10GB minimum for logs and data
# - Network: 100Mbps minimum

# For production (per instance):
# - CPU: 2 cores minimum, 4 cores recommended
# - RAM: 4GB minimum, 8GB recommended
# - Storage: 50GB minimum for logs and data
# - Network: 1Gbps recommended

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Database connection tuning
# TIMESCALE_MAX_CONNECTIONS=100  # Adjust based on load
# TIMESCALE_POOL_SIZE=20         # Adjust based on concurrent operations

# WebSocket tuning
# MAX_CONNECTIONS=100            # Adjust based on expected charger count
# HEARTBEAT_INTERVAL=30          # Adjust based on network stability
# MESSAGE_TIMEOUT=60             # Adjust based on message processing time

# Rate limiting tuning
# EXPECTED_STATIONS=100          # Set to actual number of chargers
# RATE_LIMIT_PER_MINUTE=100      # Adjust based on charger message frequency

# =============================================================================
# RAILWAY TRIAL DEPLOYMENT (two services: API + WebSocket Handler)
# =============================================================================
# Set these in Railway dashboard per service. Mark credentials as Secret in Railway.
#
# --- API service ---
# DATABASE_URL=<external TimescaleDB URL>     # Secret. Required.
# JWT_SECRET_KEY=<e.g. openssl rand -hex 32> # Secret. Required.
# OCPP_SERVER_ENABLED=false
# OCPP_USE_SAME_PORT=false
# CORS_ORIGINS=https://your-frontend.example.com
# ENVIRONMENT=production
# OPTIMIZATION_TIMEOUT=60
# OPTIMIZATION_MIP_GAP=0.01
# GUROBI_LIC_CONTENT=<contents of gurobi.lic> # Secret. Optional; HiGHS used if unset.
# MAXMIND_ACCOUNT_ID=<from maxmind.com>       # Secret. Required since MaxMind's
#                                             # 2024 policy change — paired with
#                                             # MAXMIND_LICENSE_KEY in HTTP Basic
#                                             # Auth (account ID = username,
#                                             # license key = password). Set as
#                                             # BOTH a Build and a Service variable,
#                                             # same as MAXMIND_LICENSE_KEY below.
# MAXMIND_LICENSE_KEY=<from maxmind.com>      # Secret. Set as BOTH a Build variable
#                                             # (Dockerfile downloads at build) AND a
#                                             # Service variable (runtime fallback
#                                             # in geo_block.py re-downloads with
#                                             # retries if build-time download was
#                                             # skipped or hit a transient outage).
#                                             # Requires MAXMIND_ACCOUNT_ID; without
#                                             # it the download is skipped (fail-closed).
#
# Geo-blocking proxy-trust knobs (Article 73-3 compliance behind a reverse
# proxy). Defaults are correct for Railway / Render / Fly.io; only override
# if you front the API with a public-IP load balancer.
# GEO_BLOCK_TRUST_PROXY_HEADERS=true          # When the immediate TCP peer is
#                                             # private/loopback/link-local or in
#                                             # the RFC 6598 CGNAT range
#                                             # (100.64.0.0/10, used by Railway's
#                                             # internal proxy network), parse
#                                             # Forwarded / X-Forwarded-For /
#                                             # X-Real-IP and geo-check the real
#                                             # client IP. Set "false" only if
#                                             # you terminate TLS in the app
#                                             # process with no proxy in front.
# GEO_BLOCK_TRUSTED_PROXY_RANGES=             # Optional comma-separated CIDR
#                                             # list of additional trusted proxy
#                                             # peers (e.g. an on-prem LB on a
#                                             # public IP). Public-internet peers
#                                             # are NEVER implicitly trusted, so
#                                             # spoofed X-Forwarded-For from the
#                                             # open internet is ignored.
#
# --- WebSocket Handler service ---
# WEBSOCKET_PORT=$PORT                        # Use Railway's PORT so WSS works.
# TIMESCALE_SERVICE_URL=<same as API> or set PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, PGSSLMODE  # Secret for credentials.
# SUPABASE_URL=... SUPABASE_ANON_KEY=... SUPABASE_SERVICE_KEY=...  # Secrets for keys.
# SUPABASE_DB_HOST=... SUPABASE_DB_PORT=... SUPABASE_DB_NAME=... SUPABASE_DB_USER=... SUPABASE_DB_PASSWORD=...  # Secret for password.
# USE_KUBERNETES_SECRETS=false
# FALLBACK_TO_ENV=true
# ENVIRONMENT=production

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. Never commit this file with real credentials
# 2. Use environment-specific values for different deployments
# 3. Rotate credentials regularly
# 4. Use TLS certificates in production
# 5. Enable client certificate verification for enhanced security
# 6. Monitor access logs and failed authentication attempts
