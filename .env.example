# Favonius Energy EV Fleet Depot Optimization Platform
# Copy this file to .env and fill in your actual values
#
# Reference: PRD_v2.md, Development Plan Phase 7

# =============================================================================
# DOCKER COMPOSE CONFIGURATION (Phase 7)
# =============================================================================

# Database password for TimescaleDB container
DB_PASSWORD=favonius_dev

# Gurobi license (required for primary solver per PRD Section 8.2)
# Place your gurobi.lic file in the project root
GUROBI_LICENSE_FILE=/opt/gurobi/gurobi.lic

# OCPP Simulator settings (for testing profile)
NUM_CHARGERS=10
CHARGER_PREFIX=charger_
SIMULATION_MODE=responsive

# EVerest demo image tag for docker-compose.everest.yml
EVEREST_TAG=2025.10.0-single-phase
EVEREST_CHARGE_POINT_ID=charger_01
# EVEREST_CSMS_URI=api:9000/charger_01

# Grafana credentials (for monitoring profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# CORS configuration
CORS_ORIGINS=*

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development/staging/production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=false

# Supabase JWT → static DB tenant mirror (see CLAUDE.md "Tenant mirroring")
# Cache TTL in seconds per user (sub); reduces UPSERT frequency on hot paths
# TENANT_MIRROR_TTL_S=300

# =============================================================================
# FASTAPI API — DUAL POSTGRES (production / staging)
# =============================================================================
#
# DATABASE_URL — Supabase Postgres URI for static/reference tables (sites, vehicles,
#   charging_stations, schedules, JWT tenant mirror, …).
#
# TIMESCALE_SERVICE_URL — TigerCloud (e.g. favonius-timeseries) for time-series and
#   operational tables (telemetry, prices, charging_sessions, connector_status,
#   optimization_runs, …). Required when ENVIRONMENT is production or staging for
#   both the API and the WebSocket handler so the ts pool never points at Supabase.
#
# Local single-container dev may omit TIMESCALE_SERVICE_URL; the API falls back to
# DATABASE_URL for the ts pool only when ENVIRONMENT is development (or unset).
#
# DATABASE_URL=postgresql://...@db.<ref>.supabase.co:5432/postgres
# TIMESCALE_SERVICE_URL=postgres://tsdbadmin:...@....tsdb.cloud.timescale.com:31413/tsdb?sslmode=require
#
# Read-only schema check (charger/session enrichment columns): same URL as migrations.
#   TIMESCALE_SERVICE_URL=... python scripts/verify_timescale_schema.py

# =============================================================================
# WEBSOCKET SERVER CONFIGURATION
# =============================================================================

# WebSocket server settings
# OCPP_USE_SAME_PORT: true = serve OCPP at /ocpp/{charge_point_id} on same port as REST (e.g. Railway)
OCPP_USE_SAME_PORT=false
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=9000
MAX_CONNECTIONS=100
HEARTBEAT_INTERVAL=30
MESSAGE_TIMEOUT=60
MAX_MESSAGE_SIZE=65536
RATE_LIMIT_PER_MINUTE=100
# Server-initiated WebSocket ping/pong cadence. Defaults chosen for the ABB
# Terra AC v1.8.x firmware family running at the HRX Vilnius pilot, which
# tears down the socket if its internal keepalive timer (~25-30s) elapses
# without inbound traffic. Pinging every 15s keeps the charger's timer
# fresh even during stretches of one-way packet loss. Raise these only if
# you've confirmed the connected chargers tolerate longer idle gaps.
WEBSOCKET_PING_INTERVAL=15
WEBSOCKET_PING_TIMEOUT=20

# Forwarded IP handling for charger connections behind Railway/Nginx/load balancers.
# Forwarded headers are trusted only from private/loopback peers by default, or from
# proxies listed in OCPP_TRUSTED_PROXY_RANGES. Direct public charger clients cannot
# spoof these headers.
OCPP_TRUST_PRIVATE_PROXY_HEADERS=true
# OCPP_TRUSTED_PROXY_RANGES=203.0.113.10/32,2001:db8::/32

# Synthesised-delta fallback for the close path. When StartTransaction
# carried meterStart=0 AND no MeterValues with Energy.Active.Import.Register
# arrived during the session, the close path treats meterStop as the
# per-session delta if it's below this cap. 50 kWh is sized for the pilot
# fleet (vehicles with ≤200 kWh batteries, single-session AC deliveries
# realistically ≤50 kWh). Lower the cap to be stricter; widen it only
# when you operate larger-pack vehicles AND have audited the chargers.
# Invalid / non-positive values silently fall back to 50 kWh.
# OCPP_SYNTHESIZED_DELTA_CAP_KWH=50

# =============================================================================
# TLS/SSL CONFIGURATION (Optional)
# =============================================================================

# TLS certificate paths (optional for local development)
# TLS_CERT_PATH=/path/to/server.crt
# TLS_KEY_PATH=/path/to/server.key
# TLS_CA_PATH=/path/to/ca.crt
# TLS_VERIFY_CLIENT=false

# =============================================================================
# TIMESCALEDB CONFIGURATION (WebSocket handler + shared naming)
# =============================================================================

# A single TIMESCALE_SERVICE_URL is enough: host/port/user/password/database are
# parsed from the URI. PGHOST/PGUSER/… are optional overrides.
# TimescaleDB connection settings
TIMESCALE_SERVICE_URL=postgresql://username:password@host:port/database?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=ev_charging
PGUSER=postgres
PGPASSWORD=password
PGSSLMODE=require

# Connection pool settings.
# IMPORTANT: TIMESCALE_MAX_CONNECTIONS is the per-replica ceiling for the
# asyncpg pool. The EnhancedConnectionPool also opens a small independent
# SQLAlchemy QueuePool (default pool_size=1, max_overflow=4) for cold pandas
# reporting, so total per-replica is roughly TIMESCALE_MAX_CONNECTIONS + 5.
# Multiply that by the number of replicas + the API service's pool
# (DB_POOL_MAX_SIZE, default 25) and stay well under the cluster's
# Postgres max_connections (TigerCloud Free ≈ 25, Pro ≈ 100, Supabase Pro
# ≈ 200). Raise only when steady-state concurrency genuinely needs more.
TIMESCALE_MAX_CONNECTIONS=15
TIMESCALE_POOL_SIZE=3
TIMESCALE_STATEMENT_TIMEOUT=30
TIMESCALE_IDLE_TIMEOUT=600
# Optional overrides for the small reporting-only SQLAlchemy pool. Bump
# only if you run many concurrent pandas reports.
# SQLALCHEMY_POOL_SIZE=1
# SQLALCHEMY_MAX_OVERFLOW=4

# Data retention and compression
TIMESCALE_CHUNK_INTERVAL=1 day
TIMESCALE_COMPRESSION_AFTER=7 days
TIMESCALE_RETENTION_PERIOD=2 years

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Supabase database connection (for direct access)
SUPABASE_DB_HOST=aws-1-us-east-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# Connection settings
SUPABASE_MAX_CONNECTIONS=20
SUPABASE_CONNECTION_TIMEOUT=30
SUPABASE_ENABLE_REALTIME=true

# WebSocket-handler JWT signing key (REQUIRED). Used to sign and verify the
# short-lived JWTs the WS handler issues to authenticated clients. The
# handler refuses to start without it. Generate with `openssl rand -base64 48`.
# Do NOT reuse SUPABASE_SERVICE_KEY — that key bypasses RLS and grants full
# database access; using it as a signing key turns any leaked WS JWT into a
# forgery oracle for arbitrary credentials.
# WS_AUTH_JWT_SIGNING_KEY=
# WS_AUTH_JWT_SIGNING_KEY_PREVIOUS=     # honoured during rotation windows
# WS_AUTH_JWT_ISSUER=favonius-websocket-handler
# WS_AUTH_JWT_AUDIENCE=favonius-websocket-api

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus metrics
METRICS_PORT=8080
HEALTH_CHECK_PORT=8081

# Auth gate on /metrics. Required in production — startup raises if unset.
# When unset in dev, /metrics returns 503 so an unconfigured deploy never
# silently leaks operational data. Configure the Prometheus scraper via
# the standard authorization.credentials_file pattern:
#   scrape_configs:
#     - job_name: favonius-api
#       authorization:
#         credentials_file: /etc/prometheus/metrics-token
# Generate with `openssl rand -base64 32`.
# METRICS_TOKEN=

# Logging
LOG_LEVEL=INFO
ENABLE_TELEMETRY=true

# Rate limiting configuration
EXPECTED_STATIONS=100
RATE_LIMIT_ENABLED=true

# =============================================================================
# PRICE FEEDER CONFIGURATION (ENTSO-E day-ahead prices for European depots)
# =============================================================================

PRICE_FEEDER_ENABLED=true
PRICE_FEEDER_FETCH_INTERVAL=900
PRICE_FEEDER_LOOKAHEAD_HOURS=24

# Comma-separated list of ENTSO-E EIC bidding zone codes to monitor.
# Examples: 10YLT-1001A0008Q (LT), 10Y1001A1001A82H (DE-LU),
#           10YFR-RTE------C (FR), 10YNL----------L (NL)
PRICE_FEEDER_ENTSOE_ZONES=

# ENTSO-E Transparency Platform API security token.
# Required for both (a) the optimization engine's $/kWh inputs and
# (b) per-session billing in src/core/billing/session_cost.py — without
# fresh price ingestion, closed sessions land cost_total_source='unpriceable'.
EUROPEAN_ELECTRICITY_API=

# =============================================================================
# CHARGER LOG EXTRACTION (GetDiagnostics / GetLog)
# =============================================================================

# Public URL the chargers reach to upload their diagnostic archive (the
# ``location`` field in OCPP GetDiagnostics). The path must resolve to
# ``POST /internal/charger_logs/upload`` on this API service. Without
# this set, the trigger endpoint returns 503 — chargers behind NAT
# need a routable URL.
CHARGER_LOG_UPLOAD_BASE_URL=

# HMAC signing key for the upload-URL tokens. 32+ random bytes,
# encoded however you like (the helper treats it as opaque). Rotate
# by setting a new value and accepting that any in-flight URLs become
# unusable — operators just re-fetch.
CHARGER_LOG_UPLOAD_SIGNING_KEY=

# How long an upload-URL token is valid (default 3600 s = 1 h).
# Floor of 60 s enforced by the helper.
CHARGER_LOG_UPLOAD_TOKEN_TTL_S=3600

# Per-upload size cap (default 50 MiB). Bodies exceeding this return
# 413 — both via the MaxBodySizeMiddleware Content-Length check and
# the in-handler ``len(body)`` check.
CHARGER_LOG_UPLOAD_MAX_BYTES=52428800

# =============================================================================
# OPTIMIZATION ENGINE CONFIGURATION
# =============================================================================

# Optimization service settings
OPTIMIZATION_ENABLED=true
OPTIMIZATION_HORIZON_HOURS=4
OPTIMIZATION_TIMESTEP_MINUTES=60

# Battery constraints
OPTIMIZATION_SOC_MIN=0.2
OPTIMIZATION_SOC_TARGET=0.8
OPTIMIZATION_CHARGE_POWER_KW=22.0
OPTIMIZATION_DISCHARGE_POWER_KW=10.0
OPTIMIZATION_BATTERY_CAPACITY_KWH=75.0

# =============================================================================
# MINIMUM HARDWARE REQUIREMENTS
# =============================================================================

# For development:
# - CPU: 2 cores minimum, 4 cores recommended
# - RAM: 4GB minimum, 8GB recommended
# - Storage: 10GB minimum for logs and data
# - Network: 100Mbps minimum

# For production (per instance):
# - CPU: 2 cores minimum, 4 cores recommended
# - RAM: 4GB minimum, 8GB recommended
# - Storage: 50GB minimum for logs and data
# - Network: 1Gbps recommended

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Database connection tuning. Defaults (15/3) are sized for a small pilot
# on a shared Postgres. Raise only after confirming the cluster's
# max_connections has headroom (see the comment above the canonical
# settings ~line 116).
# TIMESCALE_MAX_CONNECTIONS=15   # Adjust based on load
# TIMESCALE_POOL_SIZE=3          # Adjust based on concurrent operations

# WebSocket tuning
# MAX_CONNECTIONS=100            # Adjust based on expected charger count
# HEARTBEAT_INTERVAL=30          # Adjust based on network stability
# MESSAGE_TIMEOUT=60             # Adjust based on message processing time

# Rate limiting tuning
# EXPECTED_STATIONS=100          # Set to actual number of chargers
# RATE_LIMIT_PER_MINUTE=100      # Adjust based on charger message frequency

# =============================================================================
# RAILWAY TRIAL DEPLOYMENT (two services: API + WebSocket Handler)
# =============================================================================
# Set these in Railway dashboard per service. Mark credentials as Secret in Railway.
#
# --- API service ---
# DATABASE_URL=<Supabase Postgres URI>        # Secret. Required. Static schema only.
# TIMESCALE_SERVICE_URL=<TigerCloud Timescale URI>  # Secret. Required when ENVIRONMENT
#                                             # is production or staging (favonius-timeseries).
# JWT_SECRET_KEY=<Supabase legacy HS256 secret>  # Secret. Required for HS256 tokens
#                                                # (Dashboard → Settings → API → JWT Secret).
# JWT_SECRET_KEY_PREVIOUS=<previous HS256 secret> # Secret. Optional; honoured during a
#                                                # rotation window so old + new tokens
#                                                # are both valid.
# SUPABASE_URL=https://<ref>.supabase.co        # Required when the project uses the new
#                                               # asymmetric JWT Signing Keys (ES256/RS256).
#                                               # Backend derives the JWKS URL automatically.
# SUPABASE_JWKS_URL=<full JWKS URL>             # Optional override of the derived URL.
# JWT_JWKS_CACHE_LIFESPAN_S=3600                # Optional; PyJWKClient cache TTL.
# JWT_ISSUER=https://<ref>.supabase.co/auth/v1  # Optional; if set, the iss claim must match.
# FAVONIUS_ADMIN_EMAIL_DOMAINS=favoniusenergy.com  # Optional; comma-separated email domains
#                                                  # whose verified JWT subjects auto-promote
#                                                  # to favonius_admin. Setting this replaces
#                                                  # the default — include the original entry
#                                                  # explicitly to keep it.
# OCPP_SERVER_ENABLED=false
# OCPP_USE_SAME_PORT=false
# CORS_ORIGINS=https://your-frontend.example.com
# ENVIRONMENT=production
# OPTIMIZATION_TIMEOUT=60
# OPTIMIZATION_MIP_GAP=0.01
# SOLVER_PROCESS_POOL_SIZE=2                  # Worker processes that run MILP
#                                             # solves out of the API process. Each
#                                             # worker isolates a solve so the
#                                             # asyncio event loop stays responsive
#                                             # during a 60 s solve. Default 2.
# SOLVER_WORKER_AS_LIMIT_MB=1500              # RLIMIT_AS ceiling per solver
#                                             # worker. A runaway problem instance
#                                             # crashes the worker, not the API.
# SOLVER_PROCESS_POOL_DISABLED=false          # Set 'true' to fall back to running
#                                             # solves in a thread inside the API
#                                             # process. Use for debugging only —
#                                             # the loop will briefly block.
# GUROBI_LIC_CONTENT=<contents of gurobi.lic> # Secret. Optional; HiGHS used if unset.
# MAXMIND_ACCOUNT_ID=<from maxmind.com>       # Secret. Required since MaxMind's
#                                             # 2024 policy change — paired with
#                                             # MAXMIND_LICENSE_KEY in HTTP Basic
#                                             # Auth (account ID = username,
#                                             # license key = password). Service
#                                             # (runtime) variable only — never set
#                                             # as a Docker build arg, since that
#                                             # would leak it into image history.
# MAXMIND_LICENSE_KEY=<from maxmind.com>      # Secret. Service (runtime) variable
#                                             # only. src/security/geo_block.py::
#                                             # _download_geoip_db downloads
#                                             # GeoLite2-Country.mmdb on startup
#                                             # (retries with linear backoff).
#                                             # Requires MAXMIND_ACCOUNT_ID;
#                                             # without either the download is
#                                             # skipped and the app fails closed.
#
# Geo-blocking proxy-trust knobs (Article 73-3 compliance behind a reverse
# proxy). Defaults are correct for Railway / Render / Fly.io; only override
# if you front the API with a public-IP load balancer.
# GEO_BLOCK_TRUST_PROXY_HEADERS=true          # When the immediate TCP peer is
#                                             # private/loopback/link-local or in
#                                             # the RFC 6598 CGNAT range
#                                             # (100.64.0.0/10, used by Railway's
#                                             # internal proxy network), parse
#                                             # Forwarded / X-Forwarded-For /
#                                             # X-Real-IP and geo-check the real
#                                             # client IP. Set "false" only if
#                                             # you terminate TLS in the app
#                                             # process with no proxy in front.
# GEO_BLOCK_TRUSTED_PROXY_RANGES=             # Optional comma-separated CIDR
#                                             # list of additional trusted proxy
#                                             # peers (e.g. an on-prem LB on a
#                                             # public IP). Public-internet peers
#                                             # are NEVER implicitly trusted, so
#                                             # spoofed X-Forwarded-For from the
#                                             # open internet is ignored.
#
# --- WebSocket Handler service ---
# WEBSOCKET_PORT=$PORT                        # Use Railway's PORT so WSS works.
# TIMESCALE_SERVICE_URL=<same TigerCloud URI as API>  # Secret. Required in production/staging.
#                                             # Optional PGHOST/PGUSER/… only if not embedded in the URL.
# SUPABASE_URL=... SUPABASE_ANON_KEY=... SUPABASE_SERVICE_KEY=...  # Secrets for keys.
# SUPABASE_DB_HOST=... SUPABASE_DB_PORT=... SUPABASE_DB_NAME=... SUPABASE_DB_USER=... SUPABASE_DB_PASSWORD=...  # Secret for password.
# USE_KUBERNETES_SECRETS=false
# FALLBACK_TO_ENV=true
# ENVIRONMENT=production

# =============================================================================
# DEPOT CHAT AGENT (LLM-powered, see docs/plans/agent_search_architecture_v0.md)
# =============================================================================

# Master feature flag for the /agent/* router (POST /agent/turn,
# POST /agent/turn/stream, GET /agent/runs/{id}). Default ON since sprint B6
# (golden test suite passed, AT-18 green). Set to "false" to disable without
# redeploying code — see src/api/agent/feature_flag.py.
AGENT_SEARCH_ENABLED=true

# Model used by the depot chat agent. Must be one of the known-good
# Anthropic model IDs (see KNOWN_GOOD_MODELS in src/api/agent/llm.py).
# Switching models is a redeploy of this env var, not a code change.
# Default: claude-sonnet-4-6.
AGENT_LLM_MODEL=claude-sonnet-4-6

# Per-step token budgets and generation knobs.
AGENT_LLM_EXTRACT_MAX_TOKENS=400
AGENT_LLM_FORMAT_MAX_TOKENS=800
AGENT_LLM_TEMPERATURE=0.0
AGENT_LLM_TIMEOUT_S=30

# Anthropic API key. Plumbed through the rotation-aware secrets manager
# at src/security/secrets.py (same pattern as JWT_SECRET_KEY); set
# ANTHROPIC_API_KEY_PREVIOUS during a rotation window so both keys verify.
# NEVER commit a real key here.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_PREVIOUS=

# Text-to-SQL agent (SQL mode) — gated by AGENT_SQL_MODE_ENABLED.
# When ON, the planner routes off-script analytics questions (anything
# outside the consumption_by_user fast path) to a tool-use loop over the
# curated `agent_views.*` SECURITY DEFINER table-functions defined in
# migrations 042 (TS) and supabase/040. The loop is read-only by
# construction: the executor swaps to `agent_reader_ts` / `agent_reader_static`
# and asserts current_user, the validator rejects anything outside the
# function allowlist, and `agent_runs` carries an append-only audit trigger.
# Default OFF — flip true only after migrations 042 + supabase/040 land
# and the per-org allowlist is set.
AGENT_SQL_MODE_ENABLED=false

# Optional comma-separated UUIDs of organisations allowed to use SQL mode.
# Unset (or empty) means every org with SQL mode enabled gets it; set to
# a single UUID for canary rollout.
# AGENT_SQL_ORG_ALLOWLIST=

# =============================================================================
# DEPOT AGENT (workflows + decision log, see docs/PRD_Depot_Agent.md)
# =============================================================================

# Master feature flag for the Depot Agent runtime. Sprint 1 ships the
# substrate (migration 037 tables, src/api/agent_workflows/) but no
# runtime — flipping this on without the later sprints enables nothing.
# Default OFF. See src/api/agent_workflows/feature_flag.py.
DEPOT_AGENT_ENABLED=false

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. Never commit this file with real credentials
# 2. Use environment-specific values for different deployments
# 3. Rotate credentials regularly
# 4. Use TLS certificates in production
# 5. Enable client certificate verification for enhanced security
# 6. Monitor access logs and failed authentication attempts
