    {"type": "string", "additionalProperties": false, "description": "Unique identifier of the message.", "format": "uuid"},
    {"type": "string", "additionalProperties": false, "description": "Action of the message.", "enum": ["BootNotification", "ProvideChargingRequests", "ProvideChargingInformation"]},
