# OCPP Charger Simulator
# Simulates multiple OCPP 1.6 charge points for testing
#
# Reference: PRD_v2.md Section 9.1 (OCPP Integration)
#            Development Plan Phase 7

# TODO: Pin by SHA256 digest for supply-chain safety (run: docker pull python:3.12-slim && docker inspect --format='{{.RepoDigests}}' python:3.12-slim)
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for OCPP simulation
RUN pip install --no-cache-dir \
    websockets>=12.0 \
    ocpp>=0.27.0 \
    asyncio

# Copy simulator script
COPY scripts/ocpp_simulator.py ./ocpp_simulator.py

# Environment variables for configuration
ENV OCPP_SERVER_URL=ws://localhost:9000/ocpp
ENV NUM_CHARGERS=10
ENV CHARGER_PREFIX=charger_
ENV SIMULATION_MODE=responsive

# Security: run as non-root user
RUN useradd -r -u 1001 -s /usr/sbin/nologin simulator && \
    chown -R simulator:simulator /app
USER simulator

# Health check - verify the simulator module can be imported
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import ocpp_simulator; import sys; sys.exit(0)" || exit 1

# Run simulator
CMD ["python", "ocpp_simulator.py"]
